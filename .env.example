# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM provider ---
# Choose one. Default to Anthropic per the project plan.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Base settlement chain (EasyA Hackathon Track 2: x402 on Base) ---
# Base Sepolia testnet for the demo. Get RPC + API key from
# portal.cdp.coinbase.com; get test ETH + USDC from
# portal.cdp.coinbase.com/products/faucet.
BASE_NETWORK=base-sepolia
BASE_RPC_URL=https://sepolia.base.org
BASE_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # USDC on Base Sepolia (official Circle deployment)

# --- Coinbase Developer Platform (for x402 SDK + RPC) ---
# Get API key at portal.cdp.coinbase.com.
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# --- Agent wallets on Base Sepolia ---
# Three EOAs for the three demo agents. Hex private keys (0x prefix).
# Treat like passwords. Never commit.
BASE_BUYER_PRIVATE_KEY=
BASE_COMPLIANCE_PRIVATE_KEY=
BASE_SANCTIONS_PRIVATE_KEY=

# --- Escrow contract (deployed once via scripts/deploy_escrow.py) ---
BASE_ESCROW_ADDRESS=

# --- x402 settlement ---
# x402 settles in USDC on Base by default. Default per-call price for
# the demo (in USDC base units, 6 decimals: 100000 = 0.10 USDC).
X402_DEFAULT_PRICE_USDC_BASE_UNITS=100000

# --- Hedera HCS audit anchor (unchanged from XRPL sibling) ---
# Cert content addresses are submitted to a Hedera Consensus Service
# topic for tamper-evident ordering. Settlement happens on Base; this
# is an additive second-ledger witness, not a replacement.
#
# Setup: portal.hedera.com → create a testnet account (free; ~3 min) →
# fund from the testnet faucet → copy account ID + DER private key.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=                  # 0.0.NNNNNN
HEDERA_OPERATOR_PRIVATE_KEY=         # DER-encoded hex
HEDERA_HCS_TOPIC_ID=                 # 0.0.NNNNNN — created via scripts/setup_hcs_topic.py
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Mock mode: synthetic HCS receipts when no live credentials are set.
# Flip to false once the four fields above are populated.
MOCK_HEDERA=true

# --- LLM cache mode ---
# "live"  = always call the LLM, write response to fixtures/
# "cache" = read from fixtures/, fail if missing (use this on stage)
LLM_CACHE_MODE=live
